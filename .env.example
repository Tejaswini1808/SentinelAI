OPENROUTER_API_KEY=
QDRANT_API_KEY=
QDRANT_URL=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-120b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,poolside/laguna-m.1:free,cohere/north-mini-code:free,meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-xs.2:free
# Optional: point at a self-hosted OpenAI-compatible vLLM server instead of OpenRouter.
# If unset, the app runs in DEMO_MODE against OpenRouter's free-tier models above.
VLLM_API_URL=
VLLM_MODEL=
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
QDRANT_COLLECTION=security_knowledge_base
EMBEDDING_DIM=2048
